{
    "version": 6,
    "configurePresets": [
        {
            "name": "dev",
            "displayName": "Windows development (Ninja + clang-cl)",
            "generator": "Ninja",
            "binaryDir": "${sourceDir}/build/dev",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Debug",
                "CMAKE_CXX_COMPILER": "clang-cl",
                "CMAKE_EXPORT_COMPILE_COMMANDS": "ON"
            }
        }
    ],
    "buildPresets": [{ "name": "dev", "configurePreset": "dev" }]
}
